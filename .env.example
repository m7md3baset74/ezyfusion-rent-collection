# Copy to .env.local. All values are for the LOCAL Supabase stack only.

# From `npx supabase status` -> "API URL"
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# From `npx supabase status` -> "Publishable key" (safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# From `npx supabase status` -> "Secret key" (server only: never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
# From `npx supabase status` -> "DB URL" (Prisma runtime connection, connects as the DB owner)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# From `npx supabase status` -> "DB URL" (Prisma CLI, e.g. prisma db pull)
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Shared secret for gateway webhook signatures. Local test value; use the same one with gateway-sim.mjs
GATEWAY_X_SIGNATURE_KEY=local_test_gateway_signature_key
# Password given to every seeded account by npm run seed. Local test value only
SEED_PASSWORD=Rent-Local-Test-2026